# ==============================================================================
# ENVIRONMENT MODE
# ==============================================================================
NODE_ENV=development

# ==============================================================================
# PUBLIC CLIENT CONFIGURATION (Vite Client-Side — Safe for Browser)
# Note: Values are populated from firebase-applet-config.json or platform env.
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# ==============================================================================
# SERVER-ONLY SECRETS (Never expose to browser / frontend bundle)
# ==============================================================================
GEMINI_API_KEY=""
APP_URL=""
# FIREBASE_SERVICE_ACCOUNT_KEY="" (Server-side admin operations only)
BOOTSTRAP_SUPERADMIN_EMAIL=""

